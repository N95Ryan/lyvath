---
import { getTranslator } from "../i18n";
import en from "../i18n/en.json";
import fr from "../i18n/fr.json";

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = getTranslator(lang as "fr" | "en");
const locale = { fr, en }[lang as "fr" | "en"];
const recordItems = locale.about.record.items;
const processSteps = locale.about.process.steps;
---

<section id="about" class="mx-auto px-4 py-16 md:py-24 text-center">
  <div class="max-w-3xl mx-auto">
    <h2 class="text-white text-4xl md:text-5xl font-bold mb-12 animate-fade-in">
      {t("about.title")}
    </h2>
  </div>
  <div class="max-w-3xl mx-auto space-y-6">
    <p
      class="text-white/90 text-lg md:text-xl leading-relaxed animate-fade-in [animation-delay:0.2s]"
    >
      {t("about.intro.brand")}
    </p>
    <p
      class="text-white/90 text-lg md:text-xl leading-relaxed animate-fade-in [animation-delay:0.2s]"
    >
      {t("about.intro.engineer")}
    </p>
    <p
      class="text-white/90 text-lg md:text-xl leading-relaxed animate-fade-in [animation-delay:0.2s]"
    >
      {t("about.decision")}
    </p>
    <p
      class="text-white/90 text-lg md:text-xl leading-relaxed animate-fade-in [animation-delay:0.2s]"
    >
      {t("about.philosophy")}
    </p>
    <div class="animate-fade-in [animation-delay:0.2s]">
      <p class="text-white/90 text-lg md:text-xl leading-relaxed">
        {t("about.process.title")}
      </p>
    </div>
  </div>
  <div class="max-w-6xl mx-auto px-4 mt-2 mb-6 animate-fade-in [animation-delay:0.2s]">
    <p
      class="text-white/90 text-lg md:text-xl tracking-tight flex flex-nowrap items-center justify-center gap-x-2 w-full overflow-x-auto"
    >
      {
        processSteps.map((step, index) => (
          <>
            {index > 0 && (
              <span class="text-cyan-400 shrink-0" aria-hidden="true">{`→`}</span>
            )}
            <span class="whitespace-nowrap shrink-0">{step}</span>
          </>
        ))
      }
    </p>
  </div>
  <div class="max-w-3xl mx-auto space-y-6">
    <div class="pt-6 animate-fade-in [animation-delay:0.6s]">
      <p class="text-2xl md:text-3xl font-bold text-white mb-4">
        {t("about.record.title")}
      </p>
      <ul class="space-y-2 text-left max-w-2xl mx-auto">
        {
          recordItems.map((item) => (
            <li class="text-lg md:text-xl text-white/90 leading-relaxed flex items-start">
              <span class="text-cyan-400 mr-3 shrink-0" aria-hidden="true">•</span>
              {item}
            </li>
          ))
        }
      </ul>
    </div>
    <div class="pt-6 animate-fade-in [animation-delay:0.4s]">
      <p class="text-2xl md:text-3xl font-bold text-purple-400 mb-4">
        🎯 {t("about.goal.title")}
      </p>
      <div class="space-y-6">
        {
          t("about.goal.description")
            .split("\n\n")
            .map((paragraph) => (
              <p class="text-white/90 text-lg md:text-xl leading-relaxed">
                {paragraph}
              </p>
            ))
        }
      </div>
    </div>
  </div>
</section>
