---
import { getTranslator } from "../i18n";
import en from "../i18n/en.json";
import fr from "../i18n/fr.json";

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = getTranslator(lang as "fr" | "en");
const locale = { fr, en }[lang as "fr" | "en"];
const recordItems = locale.about.record.items;
const processSteps = locale.about.process.steps;
const processStepLine =
  "body-copy leading-relaxed text-[clamp(0.8125rem,0.35rem+0.85vw,1.125rem)]";
---

<section id="about" class="mx-auto px-4 sm:px-6 py-12 md:py-24 text-center max-w-6xl">
  <div class="max-w-3xl mx-auto">
    <h2 class="section-heading text-white mb-10 md:mb-12 animate-fade-in">
      {t("about.title")}
    </h2>
  </div>
  <div class="max-w-3xl mx-auto space-y-8">
    <p class="body-copy animate-fade-in [animation-delay:0.2s]">
      {t("about.intro.brand")}
    </p>
    {
      t("about.intro.engineer")
        .split("\n\n")
        .map((paragraph) => (
          <p class="body-copy animate-fade-in [animation-delay:0.2s]">{paragraph}</p>
        ))
    }
    <p class="body-copy animate-fade-in [animation-delay:0.2s]">
      {t("about.decision")}
    </p>
    <p class="body-copy animate-fade-in [animation-delay:0.2s]">
      {t("about.philosophy")}
    </p>
    <div class="animate-fade-in [animation-delay:0.2s] pt-4">
      <h3 class="subsection-heading text-white mb-4 md:mb-5">
        {t("about.process.title")}
      </h3>
    </div>
  </div>
  <div
    class="w-full max-w-[100vw] mx-auto mt-4 mb-10 px-2 sm:px-4 animate-fade-in [animation-delay:0.2s]"
    aria-label={t("about.process.title")}
  >
    <p
      class={`${processStepLine} flex flex-col md:flex-row md:flex-nowrap items-center justify-center gap-y-4 md:gap-y-0 md:gap-x-5 w-full max-w-4xl mx-auto py-2 md:py-0`}
    >
      {
        processSteps.map((step, index) => (
          <>
            {index > 0 && (
              <>
                <span
                  class="text-cyan-400 shrink-0 leading-none py-1 md:hidden"
                  aria-hidden="true"
                >
                  ↓
                </span>
                <span
                  class="text-cyan-400 shrink-0 hidden md:inline"
                  aria-hidden="true"
                >
                  →
                </span>
              </>
            )}
            <span class="text-center md:whitespace-nowrap px-1 md:px-0">{step}</span>
          </>
        ))
      }
    </p>
  </div>
  <div class="max-w-3xl mx-auto space-y-10">
    <div class="pt-8 md:pt-10 animate-fade-in [animation-delay:0.6s]">
      <h3 class="subsection-heading text-white mb-4 md:mb-5">
        {t("about.record.title")}
      </h3>
      <ul class="space-y-4 md:space-y-5 text-left max-w-2xl mx-auto">
        {
          recordItems.map((item) => (
            <li class="body-copy flex items-start">
              <span class="text-cyan-400 mr-3 shrink-0" aria-hidden="true">•</span>
              {item}
            </li>
          ))
        }
      </ul>
    </div>
    <div class="pt-8 md:pt-10 animate-fade-in [animation-delay:0.4s]">
      <p class="section-heading text-purple-400 mb-6 md:mb-8">
        🎯 {t("about.goal.title")}
      </p>
      <div class="space-y-8">
        {
          t("about.goal.description")
            .split("\n\n")
            .map((paragraph) => (
              <p class="body-copy">{paragraph}</p>
            ))
        }
      </div>
    </div>
  </div>
</section>
