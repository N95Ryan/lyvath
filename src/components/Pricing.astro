---
import { getTranslator } from "../i18n";

interface Props {
  lang: "fr" | "en";
}

const { lang } = Astro.props;
const t = getTranslator(lang);

const cards = ["essential", "standard", "custom"] as const;
---

<section id="pricing" class="py-12 md:py-20 text-white">
  <div class="w-full max-w-6xl mx-auto px-4 sm:px-6">
    <h2 class="section-heading text-center mb-10 md:mb-14">
      {t("pricing.title")}
    </h2>
    <div
      class="grid grid-cols-1 sm:grid-cols-3 gap-4 sm:gap-6 max-w-5xl mx-auto animate-fade-in"
    >
      {
        cards.map((key, i) => (
          <div
            class="bg-white/5 backdrop-blur-sm border border-white/30 rounded-2xl p-6 hover:scale-105 transition-all duration-300 flex flex-col items-center text-center animate-fade-in h-full"
            style={`animation-delay: ${i * 0.1}s`}
          >
            <h3 class="text-lg sm:text-xl font-bold mb-1">
              {t(`pricing.${key}.title`)}
            </h3>
            <p class="text-sm text-gray-400">{t(`pricing.${key}.tagline`)}</p>
            <p class="text-2xl sm:text-3xl font-bold my-3">
              {t(`pricing.${key}.price`)}
            </p>
            <p class="text-sm text-gray-300">{t(`pricing.${key}.maintenance`)}</p>
            <p class="text-sm text-gray-300 mt-2">{t(`pricing.${key}.scope`)}</p>
          </div>
        ))
      }
    </div>
    <div class="mt-12 text-center space-y-4">
      <p class="text-base md:text-lg text-gray-300">{t("pricing.maintenance")}</p>
      <p class="text-base md:text-lg text-gray-300">{t("pricing.extras")}</p>
      <p class="text-sm text-gray-400">{t("pricing.note")}</p>
    </div>
  </div>
</section>
