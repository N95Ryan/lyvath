---
import { getTranslator } from "../i18n";

interface Props {
  lang: "fr" | "en";
}

const { lang } = Astro.props;
const t = getTranslator(lang);

const cards = ["standard", "long", "emergency"] as const;
---

<section id="pricing" class="py-12 md:py-20 text-white">
  <div class="w-full max-w-5xl mx-auto px-4 sm:px-6">
    <h2 class="section-heading text-center mb-10 md:mb-14">
      {t("pricing.title")}
    </h2>
    <div
      class="grid grid-cols-1 sm:grid-cols-3 gap-4 sm:gap-6 max-w-4xl mx-auto animate-fade-in"
    >
      {
        cards.map((key, i) => (
          <div
            class="bg-white/5 backdrop-blur-sm border border-white/30 rounded-2xl p-6 hover:scale-105 transition-all duration-300 flex flex-col items-center text-center animate-fade-in h-full"
            style={`animation-delay: ${i * 0.1}s`}
          >
            <h3 class="text-lg sm:text-xl font-bold mb-1">
              {t(`pricing.${key}.title`)}
            </h3>
            <div class="text-sm text-gray-400">
              {t(`pricing.${key}.duration`)}
            </div>
          </div>
        ))
      }
    </div>
    <div class="mt-12 text-center">
      <p class="text-base md:text-lg leading-loose text-gray-300 mb-6">
        {t("pricing.note")}
      </p>
    </div>
  </div>
</section>
