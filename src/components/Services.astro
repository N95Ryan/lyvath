---
import { getTranslator } from "../i18n";
import en from "../i18n/en.json";
import fr from "../i18n/fr.json";

interface Props {
  lang: "en" | "fr";
}

interface Service {
  key: string;
  icon: string;
}

const { lang } = Astro.props;
const t = getTranslator(lang);

const translations = { fr, en };

const services: Service[] = [
  { key: "build", icon: "FiCode" },
  { key: "modernize", icon: "FiRefreshCw" },
  { key: "improve", icon: "FiZap" },
  { key: "integrate", icon: "FiLink" },
];

function getItems(key: string): string[] {
  const service = translations[lang].services[
    key as keyof typeof translations.en.services
  ] as { items?: string[] } | undefined;
  return service?.items ?? [];
}
---

<section id="services" class="py-12 md:py-20 text-white">
  <div class="w-full max-w-6xl mx-auto px-4 sm:px-6">
    <h2 class="section-heading text-center mb-10 md:mb-14">
      {t("services.title")}
    </h2>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
      {
        services.map((service, index) => {
          const items = getItems(service.key);
          return (
            <div
              class="bg-white/5 backdrop-blur-sm border border-white/30 rounded-2xl p-4 sm:p-6 hover:scale-105 transition-all duration-300 animate-fade-in"
              style={`animation-delay: ${index * 0.1}s`}
            >
              <div class="text-3xl sm:text-4xl mb-3 sm:mb-4 flex justify-center">
                <svg
                  class="w-8 h-8 sm:w-12 sm:h-12 text-white"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  {service.icon === "FiCode" && (
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"
                    />
                  )}
                  {service.icon === "FiRefreshCw" && (
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M23 4v6h-6M1 20v-6h6M3.51 9a9 9 0 0114.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0020.49 15"
                    />
                  )}
                  {service.icon === "FiZap" && (
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M13 10V3L4 14h7v7l9-11h-7z"
                    />
                  )}
                  {service.icon === "FiLink" && (
                    <>
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M10 13a5 5 0 007.54.54l3-3a5 5 0 00-7.07-7.07l-1.72 1.71"
                      />
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M14 11a5 5 0 00-7.54-.54l-3 3a5 5 0 007.07 7.07l1.71-1.71"
                      />
                    </>
                  )}
                </svg>
              </div>
              <h3 class="text-lg sm:text-xl font-bold mb-2 sm:mb-3 text-center">
                {t(`services.${service.key}.title`)}
              </h3>
              <p class="text-sm text-gray-400 text-center leading-relaxed mb-4 sm:mb-5">
                {t(`services.${service.key}.description`)}
              </p>
              <ul class="space-y-2 sm:space-y-3">
                {items.map((item) => (
                  <li class="text-sm text-gray-300 flex items-start leading-relaxed">
                    <span
                      class="text-cyan-400 mr-2 shrink-0"
                      aria-hidden="true"
                    >
                      •
                    </span>
                    {item}
                  </li>
                ))}
              </ul>
            </div>
          );
        })
      }
    </div>
  </div>
</section>
