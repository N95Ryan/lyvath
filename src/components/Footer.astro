---
import { getTranslator } from "../i18n";

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = getTranslator(lang as "fr" | "en");

const currentYear = new Date().getFullYear();

const icons = {
  email: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>`,
  linkedin: `<path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>`,

  instagram: `<path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>`,
  tiktok: `<path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5 20.1a6.34 6.34 0 0 0 10.86-4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1-.1z"/>`,
};
---

<footer class="bg-black text-white border-t border-gray-700">
  <div class="container mx-auto px-4 py-8">
    <!-- Icônes des réseaux sociaux -->
    <div class="flex justify-center items-center space-x-8 mb-8">
      <a
        href="mailto:rpina.pro@gmail.com"
        class="text-white hover:text-gray-300 transition-colors duration-300"
        aria-label="Email"
      >
        <svg
          class="w-7 h-7"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          set:html={icons.email}
        />
      </a>
      <a
        href="https://www.instagram.com/code.by.nayru/"
        target="_blank"
        rel="noopener noreferrer"
        class="text-white hover:text-gray-300 transition-colors duration-300"
        aria-label="Instagram"
      >
        <svg
          class="w-7 h-7"
          fill="currentColor"
          viewBox="0 0 24 24"
          set:html={icons.instagram}
        />
      </a>
      <a
        href="https://www.tiktok.com/@codebynayru"
        target="_blank"
        rel="noopener noreferrer"
        class="text-white hover:text-gray-300 transition-colors duration-300"
        aria-label="TikTok"
      >
        <svg
          class="w-7 h-7"
          fill="currentColor"
          viewBox="0 0 24 24"
          set:html={icons.tiktok}
        />
      </a>

      <a
        href="https://www.linkedin.com/company/code-by-nayru/"
        target="_blank"
        rel="noopener noreferrer"
        class="text-white hover:text-gray-300 transition-colors duration-300"
        aria-label="LinkedIn"
      >
        <svg
          class="w-7 h-7"
          fill="currentColor"
          viewBox="0 0 24 24"
          set:html={icons.linkedin}
        />
      </a>
    </div>

    <!-- Copyright -->
    <div class="text-center">
      <p class="text-sm text-gray-400">
        © {currentYear} Code by Nayru. {t("footer.copyright")}
      </p>
    </div>
  </div>
</footer>
