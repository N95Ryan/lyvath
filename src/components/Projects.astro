---
import { getTranslator } from "../i18n";

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = getTranslator(lang as "fr" | "en");

interface Project {
  key: string;
  image: string;
  link: string;
  color: string;
}

const projects: Project[] = [
  {
    key: "neat",
    image: "/images/clients/logo_neat.png",
    link: "https://neatparis.fr",
    color: "#a3b5c4",
  },

  {
    key: "spotr",
    image: "/images/clients/logo_spotr.png",
    link: "https://apps.apple.com/fr/app/spotr-tous-les-spots-photo/id1151859681",
    color: "#07e7a8",
  },

  {
    key: "sfr",
    image: "/images/clients/logo_sfr.png",
    link: "https://www.sfrbusiness.fr/",
    color: "#b91c1c",
  },
];
---

<section id="projects" class="py-12 md:py-20 text-white">
  <div class="w-full max-w-5xl mx-auto px-4 sm:px-6">
    <h2 class="section-heading text-center mb-10 md:mb-14">
      {t("projects.title")}
    </h2>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6">
      {
        projects.map((project, index) => (
          <div
            class:list={[
              "backdrop-blur-sm border border-white/30 rounded-2xl p-4 sm:p-6 hover:scale-105 transition-all duration-300",
              index === projects.length - 1 &&
                projects.length % 2 !== 0 &&
                "sm:col-span-2 sm:max-w-md sm:mx-auto sm:w-full",
            ]}
            style={`background-color: ${project.color}15`}
          >
            <div class="flex items-center justify-center min-h-[180px] sm:min-h-[220px] md:min-h-[280px]">
              <div class="flex flex-col items-center gap-3 sm:gap-4">
                <a
                  href={project.link}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="hover:opacity-80 transition-opacity duration-300"
                >
                  <img
                    src={project.image}
                    alt={`Logo ${t(`projects.${project.key}.title`)}`}
                    class="w-20 h-20 sm:w-32 sm:h-32 object-contain rounded-xl"
                  />
                </a>
                <h3 class="text-lg sm:text-xl font-bold text-center">
                  {t(`projects.${project.key}.title`)}
                </h3>
                <p class="text-gray-300 text-xs sm:text-sm text-center leading-relaxed">
                  {t(`projects.${project.key}.description`)}
                </p>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
