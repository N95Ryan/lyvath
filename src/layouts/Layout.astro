---
import { getTranslator } from "../i18n";
import LocaleSwitch from "../components/LocaleSwitch.astro";
import Analytics from "@vercel/analytics/astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  lang: "en" | "fr";
}

const {
  title = "LYVATH • Software Engineering",
  description = "No noise, no trends, no rush. Just clean software engineering, built to last.",
  lang,
} = Astro.props;

const t = getTranslator(lang);

const metaTitle = lang === "en" ? title : "LYVATH • Ingénierie logicielle";
const metaDescription =
  lang === "en"
    ? description
    : "Pas de bruit. Pas de trends. Pas de précipitation. De l'ingénierie logicielle propre, pensée pour le long terme.";
const metaLanguage = lang === "en" ? "English" : "French";
const metaLocale = lang === "en" ? "en_US" : "fr_FR";

const canonicalUrl =
  lang === "en"
    ? "https://www.lyvath.dev/"
    : `https://www.lyvath.dev/${lang}/`;
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO -->
    <title>{metaTitle}</title>
    <meta name="description" content={metaDescription} />
    <meta name="author" content="LYVATH" />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={metaTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta
      property="og:image"
      content="https://www.lyvath.dev/images/og-image.jpg"
    />
    <meta property="og:site_name" content="LYVATH" />
    <meta property="og:locale" content={metaLocale} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={metaTitle} />
    <meta property="twitter:description" content={metaDescription} />
    <meta
      property="twitter:image"
      content="https://www.lyvath.dev/images/og-image.jpg"
    />

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalUrl} />

    <!-- hreflang -->
    <link rel="alternate" hreflang="en" href="https://www.lyvath.dev/" />
    <link rel="alternate" hreflang="fr" href="https://www.lyvath.dev/fr/" />
    <link
      rel="alternate"
      hreflang="x-default"
      href="https://www.lyvath.dev/"
    />

    <!-- Additional Meta Tags -->
    <meta name="format-detection" content="telephone=no" />
    <meta name="theme-color" content="#000000" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black" />
    <meta name="application-name" content="LYVATH" />
    <meta name="msapplication-TileColor" content="#000000" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-touch-fullscreen" content="yes" />
    <meta name="apple-mobile-web-app-title" content="LYVATH" />
    <meta name="HandheldFriendly" content="true" />
    <meta name="MobileOptimized" content="width" />
    <meta name="revisit-after" content="7 days" />
    <meta name="rating" content="general" />
    <meta name="distribution" content="global" />
    <meta name="coverage" content="Worldwide" />
    <meta name="target" content="all" />
    <meta name="audience" content="all" />
    <meta name="page-topic" content="Technology" />
    <meta name="page-type" content="Business" />
    <meta name="language" content={metaLanguage} />

  </head>
  <body class="relative min-h-screen text-white overflow-x-hidden">
    <!-- Image de fond -->
    <div class="fixed inset-0 z-0 w-full h-full">
      <img
        src="/images/bg.png"
        alt="Arrière-plan professionnel"
        class="w-full h-full object-cover object-center select-none pointer-events-none"
        aria-hidden="true"
      />
      <div class="absolute inset-0 bg-black/60" aria-hidden="true"></div>
    </div>
    <!-- Contenu principal -->
    <div class="relative z-10">
      <div class="fixed top-4 right-4 z-50">
        <LocaleSwitch />
      </div>
      <slot />
    </div>
    <Analytics />
  </body>
</html>
